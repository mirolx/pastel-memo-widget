{
  "name": "pastel-memo-widget",
  "productName": "Pastel Memo",
  "version": "1.0.2",
  "description": "파스텔 톤 데스크톱 메모 위젯",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "mirolx",
  "homepage": "https://github.com/mirolx/pastel-memo-widget",
  "repository": { "type": "git", "url": "https://github.com/mirolx/pastel-memo-widget.git" },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pastel.memo.widget",
    "productName": "Pastel Memo",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "package.json"],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "signAndEditExecutable": true
    },
    "portable": { "artifactName": "PastelMemo-portable.exe" },
    "nsis": {
      "artifactName": "PastelMemo-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pastel Memo"
    }
  }
}
